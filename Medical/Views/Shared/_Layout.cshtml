<!DOCTYPE html>
<html lang="@(T.IsBangla ? "bn" : "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f8a5f" />
    <title>@ViewData["Title"] - @T["AppName"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    
  
</head>
<body>
    <header class="topbar">
        <a class="brand" href="/">@T["AppName"]</a>

        <nav class="topnav">
            @if (User.Identity?.IsAuthenticated == true)
            {
                if (User.IsInRole("Doctor"))
                {
                    <a href="/doctor">@T["Home"]</a>
                }
                else
                {
                    <a href="/patient">@T["Home"]</a>
                    <a href="/doctors">@T["FindDoctor"]</a>
                }

                <a href="/help">@(T.IsBangla ? "সাহায্য" : "Help")</a>
            }
            else
            {
                <a href="/doctors">@T["FindDoctor"]</a>
            }
        </nav>

        <a class="lang" asp-controller="Language" asp-action="Set"
           asp-route-culture="@(T.IsBangla ? "en" : "bn")"
           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">
            @(T.IsBangla ? "English" : "বাংলা")
        </a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button class="linkbtn" type="submit">@T["Logout"]</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">@T["Login"]</a>
        }
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        © @DateTime.Now.Year @T["AppName"] &nbsp;•&nbsp;
        @(T.IsBangla ? "BMDC-যাচাইকৃত ডাক্তার, আপনার হাতের কাছে" : "BMDC-verified doctors, close to you")
    </footer>
</body>
</html>